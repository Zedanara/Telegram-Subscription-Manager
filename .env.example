BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_here
ADMIN_ID=your_admin_id_here

# Optional: set to override the constructed connection string entirely
DATABASE_URL=

# Postgres container credentials (used by docker-compose db service)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Optional overrides: default host "db" matches the docker-compose service
# name; set DB_HOST=localhost to run Alembic from the host machine instead
# of inside the docker network. DB_PORT is the port the app connects to
# (5432 inside the docker network); DB_HOST_PORT is the host-side port the
# db container's 5432 is published on (change if 5432 is already taken
# locally by another Postgres instance).
# DB_HOST=db
# DB_PORT=5432
# DB_HOST_PORT=5433

STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Webhooks are refused outright while this is empty.
STRIPE_WEBHOOK_SECRET=

# Closed Telegram channel subscribers are invited to, e.g. -1001234567890.
# The bot must be an admin there with "invite users via link" permission.
# Leave empty until the real channel exists: the invite step is then skipped
# with a warning and the rest of the payment flow still works.
CHANNEL_ID=

# Port the Stripe webhook server listens on, published by docker-compose.
# WEBHOOK_PORT=8000
