BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_admin_id_here

# Optional: set to override the constructed connection string entirely
DATABASE_URL=

# Postgres container credentials (used by docker-compose db service)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Optional overrides: default host "db" matches the docker-compose service
# name; set DB_HOST=localhost (and expose the db port) to run Alembic from
# the host machine instead of inside the docker network.
# DB_HOST=db
# DB_PORT=5432

# Epic 5 stubs - not yet used
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
